# Copy to .env for local runs. Never commit .env. On GCP these come from Secret Manager.
APP_ENV=local
# Demo users sign in as their first name (vikram, sunita, ...) with this password pattern.
# {Name} becomes the first name, e.g. {Name}@YourSuffix -> Vikram@YourSuffix. Choose your own.
DEMO_PASSWORD_TEMPLATE={Name}@your-own-suffix
SESSION_SECRET=generate-with-python--c-import-secrets-print-secrets.token_urlsafe-48
COOKIE_SECURE=false
# DATABASE_URL defaults to SQLite in the repo root. Postgres example:
# DATABASE_URL=postgresql+psycopg://kestrel@localhost:5432/kestrel
# DB_PASSWORD=
FEATURE_AI_DRAFTING=false
AI_DEMO_SIMULATE=false
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
